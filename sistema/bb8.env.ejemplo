# Copiar a /etc/bb8.env (sudo install -m 600 bb8.env.ejemplo /etc/bb8.env) y rellenar.
ANTHROPIC_API_KEY=sk-ant-...
BB8_HEAD_URL=http://bb8-head.local:8080
# Parte 4: voz por el altavoz USB de la Pi. Parte 5: cambia a cabeza y activa la búsqueda de cara.
BB8_VOZ_SALIDA=local
BB8_BUSCAR_CARA=0
# Wake word: hey_jarvis hasta que entrenes "oye BB-8" (ruta al .onnx)
BB8_WAKEWORD=hey_jarvis
# Parte 6: 1 cuando el P-MOSFET de A3 esté instalado
BB8_REPOSO_PROFUNDO=0
