# Copy to /etc/bb8.env (sudo install -m 600 bb8.env.ejemplo /etc/bb8.env) and fill in.
# The agent (OpenRouter key and model), home city, connectors and motion limits are NOT
# here: set them in the config page, http://bb8.local:8765/?token=<contents of /etc/bb8/token>.

# House plan for get_map (format in wiki/Protocolo.md § 2). Without it get_map errors.
#BB8_MAP=/home/bb8/bb8/partes/3-base-andando/mapas/mi_casa.json
# 1 = read a Bluetooth gamepad (evdev) in bb8-body; it wins over the agent.
BB8_GAMEPAD=1
# Arduino port (default /dev/ttyACM0).
#BB8_SERIAL=/dev/ttyACM0

# --- Voice front end (Python, bb8-voz) ---------------------------------------
# Part 4: speech through the Pi's USB speaker. Part 5: "cabeza" (head speaker, through bb8-body)
# and turn the head toward the voice.
BB8_VOZ_SALIDA=local
BB8_BUSCAR_CARA=0
# Transcription. Pi 3: local Whisper base takes several seconds per sentence.
# With a Groq key (free, console.groq.com) transcription goes to the cloud and is almost instant.
#BB8_STT_API_KEY=gsk_...
#BB8_WHISPER=base
# Wake word: hey_jarvis until you train "oye BB-8" (path to the .onnx)
BB8_WAKEWORD=hey_jarvis
# Part 6: 1 once the P-MOSFET on A3 is installed
BB8_REPOSO_PROFUNDO=0
