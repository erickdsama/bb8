[Unit]
Description=BB-8 power manager (light and deep sleep)
After=bb8-body.service
Requires=bb8-body.service

[Service]
User=bb8
WorkingDirectory=/home/bb8/bb8
EnvironmentFile=-/etc/bb8.env
ExecStart=/home/bb8/bb8/.venv/bin/python -m energia
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
