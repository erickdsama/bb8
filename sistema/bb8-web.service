# BB-8 web pages, off the robot. A user service on the computer that hosts them
# (for now the home PC); the robot dials out to it (bb8-body --web).
#   cp sistema/bb8-web.service ~/.config/systemd/user/ && systemctl --user enable --now bb8-web
#   sudo loginctl enable-linger $USER   # keep it running after logout and at boot
[Unit]
Description=BB-8 web pages (bb8-web)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/bb8-web --addr :8780 --data %h/.bb8-web
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
