meta {
  name: turn 90
  type: http
  seq: 8
}

post {
  url: {{base}}/mcp
  body: json
  auth: bearer
}

headers {
  Accept: application/json, text/event-stream
  Mcp-Session-Id: {{mcpSession}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 17,
    "method": "tools/call",
    "params": {
      "name": "turn",
      "arguments": {
        "degrees": 90
      }
    }
  }
}
